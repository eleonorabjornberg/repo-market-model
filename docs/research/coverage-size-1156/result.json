{
  "declaration": {
    "amendments": [
      {
        "effect": "no design, world, seed or factor changed; the figures are re-run unchanged and the record carries the new hash",
        "made": "24 October 2026, PR #1160",
        "what": "added the variants block and its note, which the #803 rule (tests/test_model_declarations.py) asks of a declaration under metadata/"
      }
    ],
    "declared_before_any_figure": true,
    "design": {
      "alpha": 0.05,
      "family": "holm",
      "flag": "scoring_protocol.COVERAGE_REQUIREMENT_IN_FORCE is patched True inside the script only; it is never set in the tree",
      "leads": [
        1,
        2,
        3,
        4,
        5
      ],
      "levels": [
        0.05,
        0.95,
        0.01,
        0.99
      ],
      "method": "thinned",
      "randomised_tie_probability": "coverage_tests.tie_hit_probability from the forecast's own discrete distribution",
      "rules": [
        "strict",
        "tie_counts",
        "randomised"
      ]
    },
    "directive": 1156,
    "hypothesis": "H1 (scoring protocol synthetic suite) and H5 step 5 (candidate choice)",
    "interval": "Wilson 95% interval on the share of paths that fail",
    "pass_rule": "a rule is named when the calibrated forecaster fails the family-wise requirement on no more than 0.05 of the paths (point estimate); if none does, none is named; if several do, all are named and none is chosen",
    "power": {
      "factors": [
        0.9,
        0.8,
        0.7
      ],
      "forecaster": "too narrow: the same law with its standard deviation multiplied by the factor, quantiles and tie probabilities from the narrowed law, outcomes from the true law",
      "note": "the factors are this declaration's choice; #961's narrow forecaster is not on main, so its width is not reproduced",
      "only_for": "each rule whose family-wise size is at most 0.05",
      "paths": 1000
    },
    "ruling": "Eleonora, 22 October 2026, PR #1137 (comment 6354246426): answers 1, 2, 3 and 5 at their defaults; answer 4 decided by this simulation",
    "size": {
      "base_seed": 1156,
      "path_seed": "base_seed * 100000 + path index; the world, then the randomised draws, from random.Random(path_seed) and random.Random(path_seed + 50000)",
      "paths": 2000
    },
    "tier": "development",
    "variants": {
      "randomised": {
        "note": "a tie is a hit with the probability the forecast's own distribution gives it"
      },
      "strict": {
        "note": "a tie with a quantile is a miss"
      },
      "tie_counts": {
        "note": "a tie with a quantile is a hit"
      }
    },
    "variants_note": "three hit rules compared on one set of paths, all three reported in every table; no model variant is added",
    "world": {
      "a": 0.8,
      "calendar_start": "2005-01-03 (business days; no locked day)",
      "days": 2000,
      "forecast_quantiles": "the integer quantile of the forecast's own discretised normal: the smallest integer k with P(Y <= k) >= level, so outcomes tie it",
      "regimes": [
        {
          "days": 800,
          "label": "calm",
          "mu": 0.0,
          "s": 0.6
        },
        {
          "days": 400,
          "label": "stress",
          "mu": 2.0,
          "s": 1.5
        },
        {
          "days": 800,
          "label": "ordinary",
          "mu": 0.5,
          "s": 1.0
        }
      ],
      "target": "round(x_t) in whole bp, x_t = mu_r + a (x_{t-1} - mu_r) + e_t, e_t ~ N(0, s_r^2); the forecaster knows x_t, the regime schedule and the law, so it is calibrated by construction"
    }
  },
