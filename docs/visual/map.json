{
  "about": "Editorial content of view N4's market map (#141 §3, #144): the parties, the flows of cash between them, and the tags that measure each flow. Every flow rests on a sourced claim in docs/visual/annotations.json. A tag names the registry (source, field) pairs it reads and the issues that concern it. No status is written here: scripts/emit_visual.py derives each tag's status from the sources registry, the panel manifest, the published run-record declarations, the tracked fixtures and docs/visual/issues.json. A pair the registry does not carry is marked expect: unregistered, and the generator refuses it once the registry does.",
  "parties": {
    "fed": "The Fed",
    "treasury": "The Treasury",
    "money_funds": "Money funds",
    "banks": "Banks",
    "dealers": "Dealers",
    "hedge_funds": "Hedge funds and others"
  },
  "flows": {
    "mmf_dealers": {
      "from": "money_funds",
      "to": "dealers",
      "kind": "repo",
      "claim": "triparty_actors"
    },
    "dealers_hf": {
      "from": "dealers",
      "to": "hedge_funds",
      "kind": "repo",
      "claim": "cleared_actors"
    },
    "sofr_all": {
      "from": "dealers",
      "to": "hedge_funds",
      "kind": "repo",
      "claim": "segments_sofr"
    },
    "mmf_fed": {
      "from": "money_funds",
      "to": "fed",
      "kind": "balance",
      "claim": "fed_cash"
    },
    "fed_banks": {
      "from": "fed",
      "to": "banks",
      "kind": "balance",
      "claim": "fed_cash"
    },
    "fed_dealers": {
      "from": "fed",
      "to": "dealers",
      "kind": "repo",
      "claim": "standing_repo"
    },
    "treasury_fed": {
      "from": "treasury",
      "to": "fed",
      "kind": "balance",
      "claim": "tax_date"
    },
    "treasury_dealers": {
      "from": "treasury",
      "to": "dealers",
      "kind": "settlement",
      "claim": "settlement"
    }
  },
