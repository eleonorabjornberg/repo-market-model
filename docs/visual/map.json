    "banks": "Banks",
    "fed": "The Fed",
    "treasury": "The Treasury",
    "money_funds": "Money funds",
    "dealers": "Dealers",
    "hedge_funds": "Hedge funds and others",
    "fhlbs": "Federal Home Loan Banks and other cash lenders"
  },
