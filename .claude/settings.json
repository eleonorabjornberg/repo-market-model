{
  "permissions": {
    "allow": [
      "Bash(git fetch origin)",
      "Bash(git merge-base --is-ancestor origin/main HEAD)",
      "Bash(git merge --ff-only origin/main)",
      "Bash(git push origin HEAD)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_edit.py\"",
            "timeout": 200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/on_stop.py\"",
            "timeout": 620
          }
        ]
      }
    ]
  }
}
