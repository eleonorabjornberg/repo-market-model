.DS_Store

# Real downloaded data and generated artifacts are reproducible and stay out of Git.
data/raw/
data/processed/
artifacts/

# Local research logs and agent handoffs. Durable conclusions are rewritten into
# the public status and decision documents before they are committed.
docs/block-*/
docs/merge-*/
docs/state-of-main-*.md
docs/track-*-decisions-*.md

# Per-machine Claude Code settings.
.claude/settings.local.json

# Scratch written by Cowork sessions; never part of a build.
Claude outputs/

# Built on main, never committed (#928): the results page, its data and the assembled research log.
# The pages job builds them (`emit_visual.py --stamp`, `check_research_log.py assemble`); the tests build
# their own copy (`tests/built_outputs.py`). CI refuses a pull request that tracks any of them.
site/index.html
docs/visual/data/
docs/research/log.md
