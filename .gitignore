__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/
.DS_Store

# Real downloaded data and generated artifacts are reproducible and stay out of Git.
data/raw/
data/processed/
artifacts/

# Local research logs and agent handoffs. Durable conclusions are rewritten into
# the public status and decision documents before they are committed.
docs/block-*/
docs/merge-*/
docs/state-of-main-*.md
docs/track-*-decisions-*.md

# Per-machine Claude Code settings. The shared ones -- .claude/settings.json and
# .claude/hooks/ -- are tracked on purpose: a hook that enforces the ownership
# contract must exist in every worktree, not in whichever one wrote it.
.claude/settings.local.json
